from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

MAX_OUTPUT = 8 * 1024 * 1024
HELPER_ID = "linspectacles-boot-loaders"
HELPER_VERSION = "0.0.8"
HELPER_PROTOCOL = 1


def reply(payload):
    sys.stdout.write(json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n")
    sys.stdout.flush()


def _bootctl_path():
    for path in ("/usr/bin/bootctl", "/bin/bootctl"):
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def bootctl_status():
    executable = _bootctl_path()
    if executable is None:
        return {"ok": False, "error": "bootctl is not installed."}
    try:
        result = subprocess.run(
            [executable, "status", "--no-pager"],
            capture_output=True,
            text=True,
            check=False,
            timeout=20,
            env={
                "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG": "C.UTF-8",
                "SYSTEMD_COLORS": "0",
                "SYSTEMD_PAGER": "cat",
                "PAGER": "cat",
            },
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Privileged bootctl status query timed out."}
    except OSError as exc:
        return {"ok": False, "error": str(exc)}
    stdout = (result.stdout or "")[:MAX_OUTPUT]
    stderr = (result.stderr or "")[:MAX_OUTPUT]
    return {
        "ok": True,
        "returncode": int(result.returncode),
        "stdout": stdout,
        "stderr": stderr,
        "truncated": len(result.stdout or "") > MAX_OUTPUT or len(result.stderr or "") > MAX_OUTPUT,
    }


def dispatch(request):
    op = request.get("op")
    if op == "ping":
        return {"ok": True, "root": os.geteuid() == 0}
    if op == "quit":
        return {"ok": True, "quit": True}
    if op == "bootctl_status":
        return bootctl_status()
    return {"ok": False, "error": "Unsupported operation"}


def stdio_server():
    if os.geteuid() != 0:
        reply({"status": "error", "error": "helper must run as root"})
        return 1
    reply({
        "status": "ready",
        "protocol": HELPER_PROTOCOL,
        "helper_id": HELPER_ID,
        "helper_version": HELPER_VERSION,
    })
    for line in sys.stdin:
        if len(line) > 65536:
            reply({"ok": False, "error": "request too large"})
            continue
        try:
            request = json.loads(line)
            if not isinstance(request, dict):
                raise ValueError("request must be an object")
            output = dispatch(request)
        except Exception as exc:
            output = {"ok": False, "error": str(exc)}
        reply(output)
        if output.get("quit"):
            break
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--stdio", action="store_true")
    args = parser.parse_args(argv)
    return stdio_server() if args.stdio else 2


if __name__ == "__main__":
    raise SystemExit(main())
